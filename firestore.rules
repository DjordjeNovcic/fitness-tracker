rules_version = '2';

// Firestore security rules za Fit Tracker.
//
// Deploy:  firebase deploy --only firestore:rules
// (ili copy-paste u Firebase Console -> Firestore -> Rules)
//
// Model podataka koji app koristi (vidi app.js):
//   users/{uid}/app/state   -> ceo lични store jednog naloga (plan, namirnice,
//                              trening, obroci, ciljevi...). Slike napretka NE
//                              idu u cloud (ostaju lokalno na uređaju).
//   sharedFoods/{barcode}   -> deljeni keš makroa po barkodu (barcode skener).

service cloud.firestore {
  match /databases/{database}/documents {

    // Svaki ulogovan korisnik vidi i menja ISKLJUČIVO svoj podstablo.
    // Ovo je server-side garancija izolacije naloga: demo (ili bilo ko) ne
    // može da pročita ni dirne tuđe podatke, čak i da app kod ima bag.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deljeni keš barkod -> makroi. Svaki ulogovan može da čita; upis je
    // ograničen i validiran da spreči "trovanje" keša i cross-user XSS:
    // tačno 8 ključeva, barkod mora da odgovara ID-u dokumenta, updatedBy ne
    // može da se laže, makroi su broj ili prazno, ime je kratak string.
    // (nutNumber() može da vrati null, zato brojevi moraju biti "broj ILI prazno".)
    match /sharedFoods/{barcode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['barcode','name','kcal','protein','carbs','fat','updatedAt','updatedBy'])
        && request.resource.data.barcode == barcode
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() < 200
        && (request.resource.data.kcal is number    || request.resource.data.kcal == null)
        && (request.resource.data.protein is number || request.resource.data.protein == null)
        && (request.resource.data.carbs is number   || request.resource.data.carbs == null)
        && (request.resource.data.fat is number     || request.resource.data.fat == null);
    }

  }
}
